{
  "ConnectionStrings": {
    "Default": "Data Source=indiefps.db",
    "Redis": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "indiefps",
    "Audience": "indiefps-client",
    "SigningKey": "DEVELOPMENT_KEY_REPLACE_IN_PRODUCTION_USE_USER_SECRETS",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 30
  },
  "Stripe": {
    "SecretKey": "sk_test_REPLACE_WITH_YOUR_KEY",
    "PublishableKey": "pk_test_REPLACE_WITH_YOUR_KEY",
    "WebhookSecret": "whsec_REPLACE_WITH_YOUR_WEBHOOK_SECRET",
    "ProPriceId": "price_REPLACE_WITH_PRO_PRICE_ID",
    "ActivationPriceId": "price_REPLACE_WITH_ACTIVATION_PRICE_ID"
  },
  "App": {
    "Environment": "Development",
    "AllowedOrigins": "http://localhost:3000",
    "SuccessUrl": "http://localhost:3000/subscription/success",
    "CancelUrl": "http://localhost:3000/subscription/cancel",
    "PortalReturnUrl": "http://localhost:3000/account"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}