root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.json]
indent_size = 2

[*.yml]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# .NET code style
[*.cs]
# Formatting
dotnet_format_options = default
dotnet_newline_before_open_brace = all
dotnet_newline_before_else = true
dotnet_newline_before_catch = true
dotnet_newline_before_finally = true
dotnet_newline_before_members_in_object_initializers = true
dotnet_newline_between_query_expression_clauses = true
dotnet_sort_system_directives_first = true

# Naming
dotnet_naming_rule.interface_should_be_prefixed_with_i.severity = suggestion
dotnet_naming_rule.interface_should_be_prefixed_with_i.symbols = interface
dotnet_naming_style.i_prefix_style.required_prefix = I
dotnet_naming_style.i_prefix_style.capitalization = pascal_case

dotnet_naming_rule.type_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.type_should_be_pascal_case.symbols = class,struct,interface,enum,delegate
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.method_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.method_should_be_pascal_case.symbols = method
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.property_should_be_pascal_case.severity = suggestion
dotnet_naming_rule.property_should_be_pascal_case.symbols = property
dotnet_naming_style.pascal_case_style.capitalization = pascal_case

dotnet_naming_rule.field_should_be_camel_case.severity = suggestion
dotnet_naming_rule.field_should_be_camel_case.symbols = private_field,internal_field
dotnet_naming_style.camel_case_style.capitalization = camel_case

dotnet_naming_rule.constant_should_be_upper_case.severity = suggestion
dotnet_naming_rule.constant_should_be_upper_case.symbols = constant
dotnet_naming_style.upper_case_style.capitalization = upper_case

# Var preferences
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = true:suggestion

# Expression-bodied members
csharp_style_expression_bodied_methods = true:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_operators = true:suggestion
csharp_style_expression_bodied_constructors = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# Pattern matching
csharp_style_pattern_matching_over_is_with_cast_check = true:suggestion
csharp_style_pattern_matching_over_as_with_null_check = true:suggestion

# Null checking
csharp_style_throw_expression = true:suggestion
csharp_prefer_null_check_over_type_check = true:suggestion

# Implicit/Explicit types
csharp_prefer_braces = true:suggestion
csharp_prefer_simple_using_statement = true:suggestion
csharp_prefer_local_over_anonymous_function = true:suggestion